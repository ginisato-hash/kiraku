<?xml version="1.0" encoding="UTF-8"?>
<!--
  喜らく Beds24速報BI 15分おき巡回 (launchd)

  導入手順:
    1) このテンプレを ~/Library/LaunchAgents/ にコピー（.template を外す）:
       cp launchd/com.yuge.kiraku.beds24-bi-refresh.plist.template \
          ~/Library/LaunchAgents/com.yuge.kiraku.beds24-bi-refresh.plist
    2) 必要ならパスを実環境に合わせて編集。
    3) 読み込み:
       launchctl load  ~/Library/LaunchAgents/com.yuge.kiraku.beds24-bi-refresh.plist
       launchctl start com.yuge.kiraku.beds24-bi-refresh
    4) 解除:
       launchctl unload ~/Library/LaunchAgents/com.yuge.kiraku.beds24-bi-refresh.plist

  二重起動防止は CLI 側 FileLock (logs/beds24_bi_refresh.lock, stale 60分) が担う。
  APIエラー時は既存BIを壊さず非ゼロ終了する。

  実行内容は scripts/refresh_beds24_bi_and_publish_r2.sh に集約する:
    1) refresh-beds24-bi --auto-months-with-bookings --publish
       （予約が1件でもある月を自動抽出してBIを再生成。仕訳/PL/BS/CF/Excelは触らない）
    2) publish-bi-r2（R2 latest/*.json,*.csv へアップロードのみ。Worker本体は再deployしない）
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yuge.kiraku.beds24-bi-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/ginisato/YugeFinance/kiraku-finance-automation/scripts/refresh_beds24_bi_and_publish_r2.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ginisato/YugeFinance/kiraku-finance-automation</string>

  <!-- 15分おき -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- 起動直後にも1回走らせたい場合は true -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/ginisato/YugeFinance/kiraku-finance-automation/logs/beds24_bi_refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ginisato/YugeFinance/kiraku-finance-automation/logs/beds24_bi_refresh.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>LANG</key>
    <string>ja_JP.UTF-8</string>
  </dict>
</dict>
</plist>
